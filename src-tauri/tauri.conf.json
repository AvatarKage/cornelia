{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cornelia Studio",
  "version": "1.0.0",
  "identifier": "com.avatarkage.cornelia.studio",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:32312",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cornelia Studio",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/icon.ico"
    ],
    "resources": [
      "../src/userdata/**/*"
    ]
  }
}
