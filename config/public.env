# Sends and saves debug/trace logs
DEBUG_CONFIG="false"
DEBUG_SNOWFLAKE="false"
DEBUG_FOLDERS="true"

# Disables unsafe SSL, developer domain, and developer client
PRODUCTION="false"

# Snowflake and other dynamic generation values
MACHINE="0" # (valid: 0-1024; default: 0)
EPOSH="2024-01-01T00:00:00Z" # (default: 2024-01-01T00:00:00Z)

# IP addresses the servers are being hosted on
IP="127.0.0.1" # (PRODUCTION=true)
IP_DEV="127.0.0.1" # (PRODUCTION=false)

# Port number
PORT="32303" # (default: 32303)  (PRODUCTION=true)
PORT_DEV="32313" # (default: 32313)  (PRODUCTION=false)

# Domains assigned to each server (PRODUCTION=true)
DOMAIN_API="api.avatarka.ge"
# Add more domains as needed

# Domains assigned to each server (PRODUCTION=false)
DOMAIN_DEV_API="api.dev.avatarka.ge"
# Add more domains as needed

