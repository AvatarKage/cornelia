{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "rootDir": "src",
    "outDir": "dist/src",

    "moduleResolution": "nodenext",
    "allowJs": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules", 
    "dist", 
    "src-tauri", 
    "vite.config.ts", 
    "generated"
  ]
}