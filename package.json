{
  "name": "cornelia",
  "version": "2.0.0",
  "license": "(c) 2026 AvatarKage. All Rights Reserved.",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "start:studio": "npx serve build -l 32302",
    "start:cornelia": "python -m src.main",
    "dev:studio": "tauri dev",
    "dev:cornelia": "python -m src.main",
    "build": "npm run clean && npm run copy:src && npm run copy:config && npm run copy:index && npm run copy:userdata && tsc",
    "copy:src": "cpx \"src/studio/**/!(*.ts|*.js)\" build/studio",
    "copy:config": "cpx \"src/config.toml\" build",
    "copy:index": "cpx \"src/index.html\" build",
    "copy:userdata": "cpx \"src/userdata/**/*\" build/userdata",
    "clean": "rimraf dist && rimraf build && rimraf src/userdata/.cache && rimraf __pycache__",
    "package:studio:windows": "tauri build --target x86_64-pc-windows-msvc",
    "package:cornelia:windows": "pyinstaller --onefile --windowed --clean --noconsole --noconfirm --icon=src/icon.ico --paths=. --collect-all pystray --collect-all PIL --add-data \"src/icon.ico;.\" --distpath build/cornelia --name cornelia ./src/main.py",
    "package:windows": "npm run package:studio:windows && npm run package:cornelia:windows",
    "package:studio": "npm run package:studio:windows",
    "package:cornelia": "npm run package:cornelia:windows",
    "package": "npm run package:studio && npm run package:cornelia"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "@types/xmlserializer": "^0.6.6",
    "canvas": "^3.2.2",
    "canvg": "^4.0.3",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "jsdom": "^29.0.1",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "png-to-ico": "^3.0.1",
    "statman-stopwatch": "^2.18.1",
    "url": "^0.11.4",
    "xmlserializer": "^0.6.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@types/xmldom": "^0.1.34",
    "cpx": "^1.5.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vite": "^6.0.3"
  }
}
