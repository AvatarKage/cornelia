{
  "name": "cornelia",
  "version": "2.0.0",
  "license": "(c) 2026 AvatarKage. All Rights Reserved.",
  "type": "module",
  "scripts": {
    "start:frontend": "npx serve dist -l 32302",
    "start:backend": "node dist/src/backend/server.js",
    "dev:frontend": "vite",
    "dev:backend": "python -m index",
    "build": "npm run clean && npm run copy:src && npm run copy:config && npm run copy:index && tsc",
    "copy:src": "cpx \"src/**/!(*.ts|*.js|*.free)\" dist/src",
    "copy:config": "cpx \"config/**/*\" dist/config",
    "copy:index": "cpx \"./index.html\" dist",
    "clean": "rimraf dist && rimraf build && rimraf generated",
    "package:frontend:windows": "tauri build --target x86_64-pc-windows-msvc",
    "package:frontend:macos": "tauri build --target x86_64-apple-darwin",
    "package:frontend:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "package:backend:windows": "pyinstaller --onefile --windowed --clean --noconsole --noconfirm --icon=src/common/assets/images/icon.ico --paths=. --collect-all pystray --collect-all PIL --add-data \"src/common/assets/images/icon.ico;.\" --distpath build --name Cornelia ./index.py",
    "package:windows": "npm run package:frontend:windows && npm run package:backend:windows",
    "package:frontend": "npm run package:frontend:windows && npm run package:frontend:macos && npm run package:frontend:linux",
    "package:backend": "pkg dist/backend/server.js --targets node20-win-x64,node20-macos-x64,node20-linux-x64 --output ../src-tauri/bin/backend/dist",
    "package": "npm run package:frontend && npm run package:backend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/xmlserializer": "^0.6.6",
    "canvas": "^3.2.2",
    "canvg": "^4.0.3",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsdom": "^29.0.1",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "png-to-ico": "^3.0.1",
    "statman-stopwatch": "^2.18.1",
    "url": "^0.11.4",
    "xmlserializer": "^0.6.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@types/xmldom": "^0.1.34",
    "cpx": "^1.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-static-copy": "^4.0.0"
  }
}
